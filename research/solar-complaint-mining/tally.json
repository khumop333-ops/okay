  "tag_definitions": {
    "savings_below_expectation": "Owner reports electricity cost/units bought did not fall as expected after install, or system cost exceeds the saving.",
    "installer_trust_scam_fear": "Prospective buyer or owner distrusts installers/financiers/pricing (scam fear, suspicious contract terms, bad review-site reputation) when choosing a provider.",
    "financing_rent_to_own_terms": "Rent-to-own/financed solar: monthly cost vs saving, price escalation, buy-out markup, lock-in or exit fees, contract opacity.",
    "workmanship_defects": "Installer workmanship or safety defects (wrong/non-spec DB parts, ungrounded system, fire hazard, unsealed roof penetrations).",
    "municipal_fixed_charge_solar_owners": "Fixed/connection/tariff charges that remain or rise for homes with solar.",
    "grid_connection_cost_delay": "High cost or long wait for a new grid connection/approvals, pushing owners off-grid.",
    "repair_downtime_no_fallback": "Fear or experience of having no power while equipment fails and is repaired, esp. no grid fallback or no loan unit.",
    "installer_aftersales_unresponsive": "Installer/seller unresponsive or deflects responsibility after payment/installation (unanswered calls/WhatsApps, hand-offs, blame-shifting).",
    "warranty_repair_delay_runaround": "Brand/distributor support or warranty repair: months-long repairs, parts awaited, untraceable job numbers, unanswered escalations, claims bounced between parties, or unhelpful agents.",
    "inverter_fault_recurring": "Inverter hardware/firmware faults that recur or are not fixed after repair (error codes, shutdowns, flicker).",
    "battery_failure_degradation": "Battery swelling, BMS faults, premature failure or capacity problems.",
    "repeat_callout_fees": "Paying repeated call-out/labour fees for faults that remain unresolved or should be under warranty.",
    "firmware_update_failure": "Remote or firmware update bricks or destabilises a working system.",
    "system_overpromised_mismatch": "Delivered system capacity/performance does not match what was sold or advertised.",
    "coc_compliance_integrity": "Certificate-of-compliance process unreliable (CoC electrician did not inspect, approved-inverter list issues).",
    "grid_voltage_issues": "High or unstable municipal voltage tripping or stressing equipment.",
    "installation_delays_lead_time": "Installation scheduling delays, long lead times, late arrivals, repeated visits.",
    "refund_returns_refused": "Seller refuses return/refund of defective goods despite consumer-protection rights.",
    "replacement_unit_quality": "Loan/replacement units are used, a different brand, or also defective.",
    "warranty_verification_serial": "Cannot verify serial number/warranty status; units supplied without warranty stickers.",
    "sseg_registration_burden": "SSEG registration fees/penalties/sign-off/process confusion.",
    "installer_misconfiguration_settings": "Owner discovers the installer configured the system incorrectly (CT coil position, discharge %, overnight grid-charge, phase layout) so expected savings do not materialise; fixing needs a second paid opinion.",
    "billing_debit_order_errors": "Rent-to-own/finance billing problems: debits after cancellation, misallocated payments, unactioned debit-order changes, promised refunds not paid, no reachable accounts department.",
    "municipal_billing_metering_mismatch": "Municipal billing/metering treats solar generation as grid consumption or needs a bidirectional/prepaid meter, undermining savings; not explained up front by the provider.",
    "warranty_claim_rejected": "Warranty claim rejected with vague or contradictory reasons (e.g. 'misuse'), no failure explanation given.",
    "inverter_battery_compat_config": "Inverter/battery/logger compatibility or configuration problems (BMS comms, current limits, odd readings, loggers) that owners must debug themselves.",
    "monitoring_app_issues": "Monitoring/alerting gaps: apps or portals offline, inaccurate, too complex, or missing alerts; owners rely on extra tools or notice faults late.",
    "cannot_verify_installation_quality": "Owner cannot judge whether the install/configuration is correct or whether the system performs as sold; relies on the installer's word or pays for a second opinion; problems found only after months or years."
  }
}
